#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

start_service() {
	config_load lcd_display
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	modprobe fbtft 2>/dev/null || true
	modprobe fb_fine3399_st7735s 2>/dev/null || \
		insmod "/lib/modules/$(uname -r)/kernel/drivers/staging/fbtft/fb_fine3399_st7735s.ko" 2>/dev/null || true
	local name_file fb_device
	for name_file in /sys/class/graphics/fb*/name; do
		[ -r "$name_file" ] || continue
		case "$(cat "$name_file")" in
			*st7735*) fb_device="/dev/$(basename "$(dirname "$name_file")")"; break ;;
		esac
	done
	[ -n "$fb_device" ] && [ -c "$fb_device" ] || {
		logger -t lcd_display "ST7735 framebuffer is unavailable"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/libexec/fine3399/lcd_display.py
	procd_set_param env FINE3399_LCD_FB="$fb_device"
	procd_set_param respawn 10 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
