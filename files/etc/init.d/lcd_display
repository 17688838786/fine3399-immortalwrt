#!/bin/sh /etc/rc.common

START=20
STOP=15
USE_PROCD=1

start_service() {
	config_load lcd_display
	local enabled theme_dir page_seconds service_seconds startup_seconds transition_seconds animation_every
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get theme_dir main theme_dir /mnt/mmcblk2p4/lcd
	config_get page_seconds main page_seconds 8
	config_get service_seconds main service_seconds 5
	config_get startup_seconds main startup_seconds 6
	config_get transition_seconds main transition_seconds 0.6
	config_get animation_every main animation_every 3

	modprobe fbtft 2>/dev/null || true
	modprobe fb_fine3399_st7735s 2>/dev/null || \
		insmod "/lib/modules/$(uname -r)/kernel/drivers/staging/fbtft/fb_fine3399_st7735s.ko" 2>/dev/null || true
	local name_file fb_device
	for name_file in /sys/class/graphics/fb*/name; do
		[ -r "$name_file" ] || continue
		case "$(cat "$name_file")" in
			*st7735*|fb_fine3399_st7*) fb_device="/dev/$(basename "$(dirname "$name_file")")"; break ;;
		esac
	done
	[ -n "$fb_device" ] && [ -c "$fb_device" ] || {
		logger -t lcd_display "ST7735 framebuffer is unavailable"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/bin/fine3399-lcd
	procd_set_param env \
		FINE3399_LCD_FB="$fb_device" \
		FINE3399_LCD_THEME_DIR="$theme_dir" \
		FINE3399_LCD_PAGE_SECONDS="$page_seconds" \
		FINE3399_LCD_SERVICE_SECONDS="$service_seconds" \
		FINE3399_LCD_STARTUP_SECONDS="$startup_seconds" \
		FINE3399_LCD_TRANSITION_SECONDS="$transition_seconds" \
		FINE3399_LCD_ANIMATION_EVERY="$animation_every"
	procd_set_param respawn 10 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "lcd_display"
}
